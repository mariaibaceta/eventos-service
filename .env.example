# Copie este archivo como .env (excluido de git) para ejecutar en local.
# En la EC2 estos valores llegan como variables de entorno desde GitHub Actions.

# Bucket S3 donde se guardan los tickets (evento{id}/{usuario}/ticket{nnn}.pdf)
S3_BUCKET=
AWS_REGION=us-east-1

# Credenciales de AWS Academy (solo para ejecutar en local; cambian en cada sesión del laboratorio).
# En la EC2 no se usan: la instancia obtiene credenciales del rol LabInstanceProfile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Carpeta donde se generan los tickets antes de subirlos (en el contenedor: /app/efs)
EFS_BASE_PATH=./efs-local

# Base de datos (H2 en archivo por defecto)
DB_URL=jdbc:h2:file:./data/eventos
